{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": null,
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "DM Sans",
      "titleFont": "DM Sans",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "labelColor": "#45615c",
      "titleColor": "#183d3c",
      "gridColor": "#e3eae5",
      "tickColor": "#cedbd2",
      "domain": false,
      "labelPadding": 6,
      "titlePadding": 10
    },
    "legend": {
      "labelFont": "DM Sans",
      "titleFont": "DM Sans",
      "labelFontSize": 10,
      "titleFontSize": 11,
      "labelColor": "#45615c",
      "orient": "bottom"
    },
    "title": {
      "font": "Fraunces",
      "fontSize": 16,
      "color": "#163f42"
    },
    "font": "DM Sans",
    "background": null
  },
  "width": 300,
  "height": 300,
  "data": {
    "url": "data/waffle_100_cells.csv"
  },
  "mark": {
    "type": "rect",
    "cornerRadius": 1,
    "stroke": "#ffffff",
    "strokeWidth": 2
  },
  "encoding": {
    "x": {
      "field": "col",
      "type": "ordinal",
      "axis": null
    },
    "y": {
      "field": "row",
      "type": "ordinal",
      "sort": "ascending",
      "axis": null
    },
    "color": {
      "field": "category",
      "type": "nominal",
      "scale": {
        "domain": [
          "Woolworths and Coles",
          "Other grocery sellers"
        ],
        "range": [
          "#12756c",
          "#d9e5de"
        ]
      },
      "legend": {
        "orient": "bottom",
        "title": null
      }
    },
    "tooltip": [
      {
        "field": "label",
        "type": "nominal",
        "title": "Combined market share"
      },
      {
        "field": "category",
        "type": "nominal",
        "title": "Group"
      }
    ]
  }
}
