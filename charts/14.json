{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": null,
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "DM Sans",
      "titleFont": "DM Sans",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "labelColor": "#45615c",
      "titleColor": "#183d3c",
      "gridColor": "#e3eae5",
      "tickColor": "#cedbd2",
      "domain": false,
      "labelPadding": 6,
      "titlePadding": 10
    },
    "legend": {
      "labelFont": "DM Sans",
      "titleFont": "DM Sans",
      "labelFontSize": 10,
      "titleFontSize": 11,
      "labelColor": "#45615c",
      "orient": "bottom"
    },
    "title": {
      "font": "Fraunces",
      "fontSize": 16,
      "color": "#163f42"
    },
    "font": "DM Sans",
    "background": null
  },
  "width": "container",
  "height": 270,
  "data": {
    "url": "data/abs_monthly_food_retail.csv"
  },
  "transform": [
    {
      "filter": "isValid(datum.yoy_pct) && datum.yoy_pct !== \"\""
    },
    {
      "calculate": "toNumber(datum.yoy_pct)",
      "as": "yoy"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "#fffdfa",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "month_name",
          "type": "ordinal",
          "sort": [
            "Jan",
            "Feb",
            "Mar",
            "Apr",
            "May",
            "Jun",
            "Jul",
            "Aug",
            "Sep",
            "Oct",
            "Nov",
            "Dec"
          ],
          "title": null,
          "axis": {
            "labelAngle": 0
          }
        },
        "y": {
          "field": "year",
          "type": "ordinal",
          "sort": "ascending",
          "title": null
        },
        "color": {
          "field": "yoy",
          "type": "quantitative",
          "title": "Annual change (%)",
          "scale": {
            "domain": [
              -1,
              11
            ],
            "range": [
              "#eef5fb",
              "#114f94"
            ],
            "clamp": true
          },
          "legend": {
            "orient": "bottom",
            "format": "+.0f",
            "gradientLength": 180
          }
        },
        "tooltip": [
          {
            "field": "year"
          },
          {
            "field": "month_name",
            "title": "Month"
          },
          {
            "field": "yoy",
            "type": "quantitative",
            "format": "+.1f",
            "title": "Change (%)"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "font": "DM Sans",
        "fontSize": 10,
        "fontWeight": "bold"
      },
      "encoding": {
        "x": {
          "field": "month_name",
          "type": "ordinal",
          "sort": [
            "Jan",
            "Feb",
            "Mar",
            "Apr",
            "May",
            "Jun",
            "Jul",
            "Aug",
            "Sep",
            "Oct",
            "Nov",
            "Dec"
          ],
          "title": null,
          "axis": {
            "labelAngle": 0
          }
        },
        "y": {
          "field": "year",
          "type": "ordinal",
          "sort": "ascending",
          "title": null
        },
        "text": {
          "field": "change_label",
          "type": "nominal"
        },
        "color": {
          "condition": {
            "test": "datum.yoy >= 6",
            "value": "#ffffff"
          },
          "value": "#15344d"
        },
        "tooltip": [
          {
            "field": "year"
          },
          {
            "field": "month_name",
            "title": "Month"
          },
          {
            "field": "yoy",
            "type": "quantitative",
            "format": "+.1f",
            "title": "Change (%)"
          }
        ]
      },
      "transform": [
        {
          "filter": "datum.year == 2025 || datum.yoy >= 8 || datum.yoy < 0"
        },
        {
          "calculate": "datum.yoy < 0 ? format(datum.yoy, '+.1f') : format(datum.yoy, '+.0f')",
          "as": "change_label"
        }
      ]
    }
  ],
  "description": "Year-on-year nominal seasonally adjusted food turnover; sequential single-hue blue palette. Negative percentage changes are labelled to one decimal place rather than rounding to -0."
}
