  "scales": [
    {
      "name": "share",
      "type": "linear",
      "domain": [
        50,
        66
      ],
      "range": [
        "#d3e7df",
        "#176a70"
      ],
      "clamp": true
    }
  ],
  "marks": [
    {
      "type": "rect",
      "name": "equal-area-tiles",
      "from": {
        "data": "tiles"
      },
      "encode": {
        "enter": {
          "x": {
            "signal": "datum.col * 122 + 10"
          },
          "y": {
            "signal": "datum.row * 90 + 10"
          },
          "width": {
            "value": 116
          },
          "height": {
            "value": 84
          },
          "cornerRadius": {
            "value": 7
          },
          "fill": {
            "scale": "share",
            "field": "wool_share"
          },
          "stroke": {
            "value": "#ffffff"
          },
          "strokeWidth": {
            "value": 2
          },
          "tooltip": {
            "signal": "datum.state + ': Woolworths ' + datum.woolworths + ', Coles ' + datum.coles + ' · Woolworths share ' + format(datum.wool_share,'.1f') + '%'"
          }
        }
      }
    },
    {
      "type": "text",
      "name": "tile-abbreviations",
      "from": {
        "data": "tiles"
      },
      "encode": {
        "enter": {
          "x": {
            "signal": "datum.col * 122 + 68"
          },
          "y": {
            "signal": "datum.row * 90 + 43"
          },
          "text": {
            "field": "code"
          },
          "font": {
            "value": "DM Sans"
          },
          "fontSize": {
            "value": 17
          },
          "fontWeight": {
            "value": "bold"
          },
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          },
          "fill": {
            "signal": "datum.wool_share >= 63 ? '#ffffff' : '#123b3d'"
          },
          "tooltip": {
            "signal": "datum.state + ': Woolworths ' + datum.woolworths + ', Coles ' + datum.coles + ' · Woolworths share ' + format(datum.wool_share,'.1f') + '%'"
          }
        }
      }
    },
    {
      "type": "text",
      "name": "tile-percentages",
      "from": {
        "data": "tiles"
      },
      "encode": {
        "enter": {
          "x": {
            "signal": "datum.col * 122 + 68"
          },
          "y": {
            "signal": "datum.row * 90 + 65"
          },
