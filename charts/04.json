{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Eight tiles only, one for each of six Australian states and ACT/NT. Every abbreviation and percentage is centered INSIDE its tile using explicit numeric center coordinates rather than band-edge offsets.",
  "background": null,
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "DM Sans",
      "titleFont": "DM Sans",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "labelColor": "#45615c",
      "titleColor": "#183d3c",
      "gridColor": "#e3eae5",
      "tickColor": "#cedbd2",
      "domain": false,
      "labelPadding": 6,
      "titlePadding": 10
    },
    "legend": {
      "labelFont": "DM Sans",
      "titleFont": "DM Sans",
      "labelFontSize": 10,
      "titleFontSize": 11,
      "labelColor": "#45615c",
      "orient": "bottom"
    },
    "title": {
      "font": "Fraunces",
      "fontSize": 16,
      "color": "#163f42"
    },
    "font": "DM Sans",
    "background": null
  },
  "width": 420,
  "height": 285,
  "data": {
    "url": "data/tiles.csv"
  },
  "transform": [
    {
      "calculate": "datum.col + 0.04",
      "as": "x0"
    },
    {
      "calculate": "datum.col + 0.96",
      "as": "x1"
    },
    {
      "calculate": "datum.row + 0.04",
      "as": "y0"
    },
    {
      "calculate": "datum.row + 0.96",
      "as": "y1"
    },
    {
      "calculate": "datum.col + 0.5",
      "as": "xc"
    },
    {
      "calculate": "datum.row + 0.5",
      "as": "yc"
    },
    {
      "calculate": "format(datum.wool_share, '.1f') + '%'",
      "as": "shareLabel"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rect",
        "cornerRadius": 6,
        "stroke": "#fffefa",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "x0",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              4
            ],
            "nice": false,
            "zero": false
          },
          "axis": null
        },
        "y": {
          "field": "y0",
          "type": "quantitative",
          "scale": {
            "domain": [
              3,
              0
            ],
            "nice": false,
            "zero": false
          },
          "axis": null
        },
        "x2": {
          "field": "x1"
        },
        "y2": {
          "field": "y1"
        },
        "color": {
          "field": "wool_share",
          "type": "quantitative",
          "title": "Woolworths share of two chains (%)",
          "scale": {
            "domain": [
              50,
              66
            ],
            "range": [
              "#d3e7df",
              "#176a70"
            ],
            "clamp": true
          },
          "legend": {
            "orient": "bottom",
            "gradientLength": 175,
            "title": "Woolworths share (%)",
            "format": ".0f"
          }
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State or territory"
          },
          {
            "field": "woolworths",
            "type": "quantitative"
          },
          {
            "field": "coles",
            "type": "quantitative"
          },
          {
            "field": "wool_share",
            "type": "quantitative",
            "format": ".1f",
            "title": "Woolworths % of two"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "font": "DM Sans",
        "fontWeight": "bold",
        "fontSize": 15,
        "align": "center",
        "baseline": "middle",
        "dy": -11
      },
      "encoding": {
        "x": {
          "field": "xc",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              4
            ],
            "nice": false,
            "zero": false
          },
          "axis": null
        },
        "y": {
          "field": "yc",
          "type": "quantitative",
          "scale": {
            "domain": [
              3,
              0
            ],
            "nice": false,
            "zero": false
          },
          "axis": null
        },
        "text": {
          "field": "code",
          "type": "nominal"
        },
        "color": {
          "condition": {
            "test": "datum.wool_share >= 58",
            "value": "#ffffff"
          },
          "value": "#153d3c"
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State or territory"
          },
          {
            "field": "woolworths",
            "type": "quantitative"
          },
          {
            "field": "coles",
            "type": "quantitative"
          },
          {
            "field": "wool_share",
            "type": "quantitative",
            "format": ".1f",
            "title": "Woolworths % of two"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "font": "DM Sans",
        "fontWeight": "bold",
        "fontSize": 11,
        "align": "center",
        "baseline": "middle",
        "dy": 12
      },
      "encoding": {
        "x": {
          "field": "xc",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              4
            ],
            "nice": false,
            "zero": false
          },
          "axis": null
        },
        "y": {
          "field": "yc",
          "type": "quantitative",
          "scale": {
            "domain": [
              3,
              0
            ],
            "nice": false,
            "zero": false
          },
          "axis": null
        },
        "text": {
          "field": "shareLabel",
          "type": "nominal"
        },
        "color": {
          "condition": {
            "test": "datum.wool_share >= 58",
            "value": "#ffffff"
          },
          "value": "#153d3c"
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State or territory"
          },
          {
            "field": "woolworths",
            "type": "quantitative"
          },
          {
            "field": "coles",
            "type": "quantitative"
          },
          {
            "field": "wool_share",
            "type": "quantitative",
            "format": ".1f",
            "title": "Woolworths % of two"
          }
        ]
      }
    }
  ]
}
