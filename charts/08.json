          "brand_short": "C",
          "stores": 17
        }
      ]
    },
    {
      "name": "tree",
      "source": "source",
      "transform": [
        {
          "type": "stratify",
          "key": "id",
          "parentKey": "parent"
        },
        {
          "type": "treemap",
          "field": "stores",
          "method": "squarify",
          "round": true,
          "sort": {
            "field": "value",
            "order": "descending"
          },
          "size": [
            {
              "signal": "width"
            },
            {
              "signal": "height"
            }
          ],
          "paddingInner": 2,
          "paddingOuter": 2,
          "paddingTop": 18
        }
      ]
    },
    {
      "name": "leaves",
      "source": "tree",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.depth == 2"
        }
      ]
    },
    {
      "name": "groups",
      "source": "tree",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.depth == 1"
        }
      ]
    },
    {
      "name": "root",
      "source": "tree",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.depth == 0"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "brand",
      "type": "ordinal",
      "domain": [
        "Woolworths",
        "Coles"
      ],
      "range": [
        "#12756c",
        "#d45039"
      ]
    }
  ],
  "marks": [
    {
      "type": "rect",
      "name": "retailer-tiles",
      "from": {
        "data": "leaves"
      },
      "encode": {
        "enter": {
          "x": {
            "field": "x0"
          },
          "x2": {
            "field": "x1"
          },
          "y": {
            "field": "y0"
          },
          "y2": {
            "field": "y1"
          },
          "fill": {
            "signal": "scale('brand',datum.data.brand)"
          },
          "stroke": {
            "value": "#fffefa"
          },
          "strokeWidth": {
            "value": 1.2
          },
          "tooltip": {
            "signal": "datum.data.state + ' · ' + datum.data.brand + ': ' + format(datum.data.stores, ',') + ' outlets'"
          }
        },
        "hover": {
          "fillOpacity": {
            "value": 0.78
          }
        },
        "update": {
          "fillOpacity": {
            "value": 1
          }
        }
      }
    },
    {
      "type": "text",
      "name": "retailer-labels",
      "from": {
        "data": "leaves"
      },
      "encode": {
        "enter": {
          "x": {
            "signal": "(datum.x0+datum.x1)/2"
          },
          "y": {
            "signal": "(datum.y0+datum.y1)/2"
          },
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          },
          "text": {
            "signal": "datum.data.brand_short"
          },
          "font": {
            "value": "DM Sans"
          },
          "fontWeight": {
            "value": "bold"
          },
          "fontSize": {
            "signal": "max(9,min(14,(datum.x1-datum.x0)/2.2))"
          },
          "fill": {
            "value": "#ffffff"
          },
          "tooltip": {
            "signal": "datum.data.state + ' · ' + datum.data.brand + ': ' + datum.data.stores + ' outlets'"
          }
        }
      }
    },
    {
      "type": "text",
      "name": "retailer-values",
      "from": {
        "data": "leaves"
      },
      "encode": {
        "enter": {
          "x": {
            "signal": "(datum.x0+datum.x1)/2"
          },
          "y": {
            "signal": "(datum.y0+datum.y1)/2 + 17"
          },
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          },
          "text": {
            "signal": "format(datum.data.stores, ',')"
          },
          "font": {
            "value": "DM Sans"
          },
          "fontSize": {
            "value": 11
          },
          "fill": {
            "value": "#ffffff"
          },
          "opacity": {
            "signal": "(datum.x1-datum.x0)>40 && (datum.y1-datum.y0)>48 ? 1 : 0"
          }
        }
      }
    },
    {
      "type": "rect",
      "name": "state-headers",
      "from": {
        "data": "groups"
      },
      "encode": {
        "enter": {
          "x": {
            "field": "x0"
          },
          "x2": {
            "field": "x1"
          },
          "y": {
            "field": "y0"
          },
          "height": {
            "value": 18
          },
          "fill": {
            "value": "#183b3d"
          }
        }
      }
    },
    {
      "type": "text",
      "name": "state-labels",
      "from": {
        "data": "groups"
      },
      "encode": {
        "enter": {
          "x": {
            "signal": "(datum.x0+datum.x1)/2"
          },
          "y": {
            "signal": "datum.y0 + 13"
          },
          "align": {
            "value": "center"
          },
          "text": {
            "signal": "datum.data.code"
          },
          "font": {
            "value": "DM Sans"
          },
          "fontWeight": {
            "value": "bold"
          },
          "fontSize": {
            "signal": "max(9,min(13,(datum.x1-datum.x0)/3))"
          },
          "fill": {
            "value": "#ffffff"
          },
          "tooltip": {
            "signal": "datum.data.state + ' · ' + format(datum.value,',') + ' outlets total'"
          }
        }
      }
    },
    {
      "type": "rect",
      "name": "total-header",
      "from": {
        "data": "root"
      },
      "encode": {
        "enter": {
          "x": {
            "field": "x0"
          },
          "x2": {
            "field": "x1"
          },
          "y": {
            "field": "y0"
          },
          "height": {
            "value": 18
          },
          "fill": {
            "value": "#e9f0e8"
          }
        }
      }
    },
    {
      "type": "text",
      "name": "total-label",
      "from": {
        "data": "root"
      },
      "encode": {
        "enter": {
          "x": {
            "signal": "datum.x0+8"
          },
          "y": {
            "signal": "datum.y0+13"
          },
          "text": {
            "value": "AUSTRALIA · 2,020 RECORDED TWO-CHAIN OUTLETS"
          },
          "font": {
            "value": "DM Sans"
          },
          "fontSize": {
            "value": 11
          },
          "fontWeight": {
            "value": "bold"
          },
          "fill": {
            "value": "#173d3b"
          }
        }
      }
    }
  ]
}
