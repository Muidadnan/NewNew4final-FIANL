{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Slopegraph comparing rankings of combined supermarket outlet totals and outlets per 100,000 residents across Australia's six states and two mainland territories. Every line and dot uses the same teal colour, with state or territory codes labelled at both ends.",
  "background": null,
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "DM Sans",
      "titleFont": "DM Sans",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "labelColor": "#45615c",
      "titleColor": "#183d3c",
      "gridColor": "#e3eae5",
      "tickColor": "#cedbd2",
      "domain": false,
      "labelPadding": 6,
      "titlePadding": 10
    },
    "legend": {
      "labelFont": "DM Sans",
      "titleFont": "DM Sans",
      "labelFontSize": 10,
      "titleFontSize": 11,
      "labelColor": "#45615c",
      "orient": "bottom"
    },
    "title": {
      "font": "Fraunces",
      "fontSize": 16,
      "color": "#163f42"
    },
    "font": "DM Sans",
    "background": null
  },
  "width": 410,
  "height": 340,
  "padding": {
    "left": 42,
    "right": 43,
    "top": 16,
    "bottom": 28
  },
  "data": {
    "url": "data/states.csv"
  },
  "transform": [
    {
      "window": [
        {
          "op": "rank",
          "as": "rankTotal"
        }
      ],
      "sort": [
        {
          "field": "total",
          "order": "descending"
        }
      ]
    },
    {
      "window": [
        {
          "op": "rank",
          "as": "rankRate"
        }
      ],
      "sort": [
        {
          "field": "per100k",
          "order": "descending"
        }
      ]
    },
    {
      "fold": [
        "rankTotal",
        "rankRate"
      ],
      "as": [
        "metric",
        "rank"
      ]
    },
    {
      "calculate": "datum.metric === 'rankTotal' ? 'Total stores' : 'Per 100k residents'",
      "as": "view"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2.3,
        "opacity": 1
      },
      "encoding": {
        "x": {
          "field": "view",
          "type": "ordinal",
          "sort": [
            "Total stores",
            "Per 100k residents"
          ],
          "axis": {
            "title": null,
            "labelAngle": 0,
            "labelFontSize": 13,
            "labelPadding": 12
          }
        },
        "y": {
          "field": "rank",
          "type": "quantitative",
          "scale": {
            "domain": [
              8.6,
              0.4
            ],
            "nice": false
          },
          "axis": {
            "title": "Rank (1 = highest)",
            "values": [
              1,
              2,
              3,
              4,
              5,
              6,
              7,
              8
            ],
            "grid": true
          }
        },
        "detail": {
          "field": "code",
          "type": "nominal"
        },
        "color": {
          "value": "#367d78"
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State or territory"
          },
          {
            "field": "total",
            "type": "quantitative",
            "title": "Combined stores"
          },
          {
            "field": "per100k",
            "type": "quantitative",
            "format": ".2f",
            "title": "Stores / 100k"
          },
          {
            "field": "rankTotal",
            "type": "quantitative",
            "title": "Total-store rank"
          },
          {
            "field": "rankRate",
            "type": "quantitative",
            "title": "Per-capita rank"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 90,
        "stroke": "#fffefa",
        "strokeWidth": 1,
        "opacity": 1
      },
      "encoding": {
        "x": {
          "field": "view",
          "type": "ordinal",
          "sort": [
            "Total stores",
            "Per 100k residents"
          ],
          "axis": {
            "title": null,
            "labelAngle": 0,
            "labelFontSize": 13,
            "labelPadding": 12
          }
        },
        "y": {
          "field": "rank",
          "type": "quantitative",
          "scale": {
            "domain": [
              8.6,
              0.4
            ],
            "nice": false
          },
          "axis": {
            "title": "Rank (1 = highest)",
            "values": [
              1,
              2,
              3,
              4,
              5,
              6,
              7,
              8
            ],
            "grid": true
          }
        },
        "color": {
          "value": "#367d78"
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State or territory"
          },
          {
            "field": "total",
            "type": "quantitative",
            "title": "Combined stores"
          },
          {
            "field": "per100k",
            "type": "quantitative",
            "format": ".2f",
            "title": "Stores / 100k"
          },
          {
            "field": "rankTotal",
            "type": "quantitative",
            "title": "Total-store rank"
          },
          {
            "field": "rankRate",
            "type": "quantitative",
            "title": "Per-capita rank"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.metric === 'rankTotal'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -12,
        "font": "DM Sans",
        "fontSize": 12,
        "fontWeight": "bold"
      },
      "encoding": {
        "x": {
          "field": "view",
          "type": "ordinal",
          "sort": [
            "Total stores",
            "Per 100k residents"
          ],
          "axis": {
            "title": null,
            "labelAngle": 0,
            "labelFontSize": 13,
            "labelPadding": 12
          }
        },
        "y": {
          "field": "rank",
          "type": "quantitative",
          "scale": {
            "domain": [
              8.6,
              0.4
            ],
            "nice": false
          },
          "axis": {
            "title": "Rank (1 = highest)",
            "values": [
              1,
              2,
              3,
              4,
              5,
              6,
              7,
              8
            ],
            "grid": true
          }
        },
        "text": {
          "field": "code",
          "type": "nominal"
        },
        "color": {
          "value": "#173d3b"
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State or territory"
          },
          {
            "field": "total",
            "type": "quantitative",
            "title": "Combined stores"
          },
          {
            "field": "per100k",
            "type": "quantitative",
            "format": ".2f",
            "title": "Stores / 100k"
          },
          {
            "field": "rankTotal",
            "type": "quantitative",
            "title": "Total-store rank"
          },
          {
            "field": "rankRate",
            "type": "quantitative",
            "title": "Per-capita rank"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.metric === 'rankRate'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 12,
        "font": "DM Sans",
        "fontSize": 12,
        "fontWeight": "bold"
      },
      "encoding": {
        "x": {
          "field": "view",
          "type": "ordinal",
          "sort": [
            "Total stores",
            "Per 100k residents"
          ],
          "axis": {
            "title": null,
            "labelAngle": 0,
            "labelFontSize": 13,
            "labelPadding": 12
          }
        },
        "y": {
          "field": "rank",
          "type": "quantitative",
          "scale": {
            "domain": [
              8.6,
              0.4
            ],
            "nice": false
          },
          "axis": {
            "title": "Rank (1 = highest)",
            "values": [
              1,
              2,
              3,
              4,
              5,
              6,
              7,
              8
            ],
            "grid": true
          }
        },
        "text": {
          "field": "code",
          "type": "nominal"
        },
        "color": {
          "value": "#173d3b"
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State or territory"
          },
          {
            "field": "total",
            "type": "quantitative",
            "title": "Combined stores"
          },
          {
            "field": "per100k",
            "type": "quantitative",
            "format": ".2f",
            "title": "Stores / 100k"
          },
          {
            "field": "rankTotal",
            "type": "quantitative",
            "title": "Total-store rank"
          },
          {
            "field": "rankRate",
            "type": "quantitative",
            "title": "Per-capita rank"
          }
        ]
      }
    }
  ]
}
